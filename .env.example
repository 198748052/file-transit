# ─────────────────────────── Server ───────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=8642

# ─────────────────────────── Auth ─────────────────────────────
# REQUIRED: long random string used to sign JWTs
JWT_SECRET=please-change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Single admin account. Set EITHER a plaintext password (hashed at startup)
# or a pre-computed bcrypt hash. Plaintext is simpler for personal use.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# ADMIN_PASSWORD_HASH=$2a$10$....

# ─────────────────────────── Storage (R2) ─────────────────────
# Leave these blank and fill them in the panel (设置 → 存储设置),
# or set them here. Placeholder values here would override the panel.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: defaults to https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

# ─────────────────────────── Uploads ──────────────────────────
# Files below this size use a single presigned PUT (MB, min 5)
MULTIPART_THRESHOLD_MB=8
# Part size for multipart uploads (MB, min 5)
UPLOAD_PART_SIZE_MB=8
# TTL for presigned upload URLs (seconds)
PRESIGNED_PUT_TTL_SECONDS=3600
# TTL for presigned download URLs (seconds) — keep short to prevent hotlinking
PRESIGNED_GET_TTL_SECONDS=300

# ─────────────────────────── Maintenance ──────────────────────
# Local SQLite database file path
DB_PATH=./data/file-transit.db
# Cron schedule for deleting expired files (default: top of every hour)
EXPIRY_CRON=0 * * * *

# ───────────────────── Remote auto-update ─────────────────────
# One-click update from GitHub: git fetch → reset --hard origin/<branch>
# → npm install + build (web & backend) → pm2 restart. Only used by the
# authenticated admin panel. The working tree must be clean (tracked files),
# .env / data/ are gitignored and preserved.
UPDATE_ENABLED=true
# UPDATE_BRANCH=main
# PM2 process name to restart after a successful build
# UPDATE_PM2_NAME=file-transit
# Directory of the git checkout (defaults to the app's working directory)
# UPDATE_REPO_DIR=/www/wwwroot/file-transit
# Cron for the background "new version available" check (read-only git fetch;
# never applies the update). Set UPDATE_ENABLED=false to disable entirely.
# UPDATE_CHECK_CRON=0 */6 * * *
